{
  "name": "leitir-cli",
  "version": "0.2.0",
  "description": "Unofficial CLI and MCP server for leitir.is, the Icelandic library catalogue (search, loans, renewals, holds)",
  "license": "MIT",
  "author": "Axel Paul Gunnarsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelpaul/leitir-cli.git"
  },
  "homepage": "https://github.com/axelpaul/leitir-cli#readme",
  "bugs": {
    "url": "https://github.com/axelpaul/leitir-cli/issues"
  },
  "keywords": [
    "leitir",
    "library",
    "iceland",
    "primo",
    "mcp",
    "cli"
  ],
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "leitir": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "serve": "bun src/index.ts serve",
    "build": "bun build --compile src/index.ts --outfile dist/leitir",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "^1.3.12",
    "typescript": "^5.9.3"
  }
}
